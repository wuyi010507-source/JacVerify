# Safe default: no external LLM request is made.
JACVERIFY_MOCK_LLM=1
JACVERIFY_MOCK_TOOLS=1

# Experimental live adapter. Keep the key only in the ignored local .env file.
JACVERIFY_LLM_BACKEND=firecrawl
FIRECRAWL_API_KEY=
JACVERIFY_FIRECRAWL_MODEL=spark-1-mini
JACVERIFY_FIRECRAWL_MAX_CREDITS=100
JACVERIFY_LLM_TIMEOUT_SECONDS=45
JACVERIFY_LLM_RETRIES=1
JACVERIFY_LLM_RETRY_DELAY_SECONDS=1
JACVERIFY_AI_TESTGEN_REPAIR_ATTEMPTS=1

# Optional byLLM fallback.
BYLLM_DEFAULT_MODEL=
OPENAI_API_KEY=
